<Window FontFamily="{DynamicResource SkinFont}" x:Class="CopilotPulse.SkinWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CopilotPulse" Title="Copilot Pulse · 换肤" Width="760" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource SkinText}" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="ScrollPart" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPart}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource SkinEdge}" CornerRadius="4" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPart}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
      </Track>
    </ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SliderPart" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Slider">
      <Setter Property="Height" Value="24"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Margin="2,0"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderPart}" Background="{DynamicResource SkinAccent}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="15" Height="15"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource SkinAccent}" Stroke="{DynamicResource SkinSurface}" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderPart}" Background="{DynamicResource SkinEdge}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
        </Track></Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Border Margin="8" Background="{DynamicResource SkinSurface}" BorderBrush="{DynamicResource SkinEdge}" BorderThickness="1" CornerRadius="20" Padding="25,22">
    <StackPanel>
      <Grid Background="Transparent" MouseLeftButtonDown="DragHeader" Margin="0,0,0,19">
        <StackPanel><TextBlock Text="COPILOT PULSE / APPEARANCE" Foreground="{DynamicResource SkinAccent}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="换一个心情" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="选择即生效 · 组件和历史窗口同步切换" Foreground="{DynamicResource SkinMuted}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
        <Button Click="ClosePicker" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="关闭换肤窗口"><Path Width="12" Height="12" Stroke="{DynamicResource SkinMuted}" StrokeThickness="1.6" Data="M1,1 L11,11 M11,1 L1,11"/></Button>
      </Grid>
      <Grid Margin="0,0,0,12"><StackPanel Orientation="Horizontal">
        <Button x:Name="MiniModeButton" Content="迷你数字" Tag="mini" FontSize="12" Click="ChangeDisplay" Margin="0,0,5,0"/>
        <Button x:Name="CompactModeButton" Content="紧凑" Tag="compact" FontSize="12" Click="ChangeDisplay" Margin="0,0,5,0"/>
        <Button x:Name="FullModeButton" Content="完整" Tag="full" FontSize="12" Click="ChangeDisplay"/>
      </StackPanel><TextBlock Text="迷你框：双击展开 / 右键设置" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource SkinFaint}"/></Grid>
      <Border Background="{DynamicResource SkinPanel}" CornerRadius="12" Padding="13,11" Margin="0,0,0,13">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="实时预览 · 示例金额" FontSize="10" Foreground="{DynamicResource SkinFaint}" Margin="7,0,0,5"/>
            <local:MoneyReadout x:Name="LivePreview" Tile="True" Preview="True" AnimatePreview="True" Height="96" Width="228" IsHitTestVisible="False"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <Grid><TextBlock Text="特效强度" FontSize="11"/><TextBlock x:Name="IntensityValue" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource SkinAccent}"/></Grid>
            <Slider x:Name="IntensitySlider" Minimum="35" Maximum="150" Value="100" SmallChange="5" LargeChange="10" ValueChanged="AdjustEffects" AutomationProperties.Name="特效强度"/>
            <Grid Margin="0,5,0,0"><TextBlock Text="动画速度" FontSize="11"/><TextBlock x:Name="SpeedValue" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource SkinAccent}"/></Grid>
            <Slider x:Name="SpeedSlider" Minimum="50" Maximum="150" Value="100" SmallChange="5" LargeChange="10" ValueChanged="AdjustEffects" AutomationProperties.Name="动画速度"/>
            <TextBlock x:Name="EffectsNote" FontSize="10" Foreground="{DynamicResource SkinFaint}" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-5,0,-5,13"><UniformGrid x:Name="SkinTiles" Columns="3" Margin="0,0,5,0"/></ScrollViewer>
      <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ImageName" Text="也可以使用自己的图片" FontSize="11" Foreground="{DynamicResource SkinMuted}" TextTrimming="CharacterEllipsis"/><TextBlock Text="PNG / JPG / BMP · 保存本机副本" FontSize="10" Foreground="{DynamicResource SkinFaint}" Margin="0,5,0,0"/></StackPanel>
        <Button Grid.Column="1" Content="选择图片…" Click="ChooseImage" Background="{DynamicResource SkinHover}" Foreground="{DynamicResource SkinText}" Padding="14,9" FontSize="12"/>
      </Grid>
      <Grid Margin="0,0,0,12"><Button x:Name="MotionButton" Content="动态效果：开启" HorizontalAlignment="Left" FontSize="11" Background="{DynamicResource SkinHover}" Click="ToggleMotion"/><TextBlock x:Name="MotionNote" Text="隐藏到托盘自动停止特效" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource SkinFaint}"/></Grid>
      <Border x:Name="PhotoPanel" Background="{DynamicResource SkinPanel}" CornerRadius="11" Padding="15,13">
        <StackPanel x:Name="PhotoControls">
          <Grid Margin="0,0,0,5"><TextBlock Text="照片遮罩" FontSize="12"/><TextBlock x:Name="DimValue" HorizontalAlignment="Right" Foreground="{DynamicResource SkinAccent}" FontSize="11"/></Grid>
          <Slider x:Name="DimSlider" Minimum="45" Maximum="85" Value="65" ValueChanged="AdjustPhoto" SmallChange="1" LargeChange="5" AutomationProperties.Name="照片遮罩深浅"/>
          <TextBlock Text="向右更暗，让数字更清楚" FontSize="10" Foreground="{DynamicResource SkinFaint}" Margin="0,3,0,12"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="水平取景" FontSize="11" Foreground="{DynamicResource SkinMuted}"/><Slider x:Name="XSlider" Minimum="0" Maximum="100" Value="50" ValueChanged="AdjustPhoto" SmallChange="1" LargeChange="10" AutomationProperties.Name="背景水平取景"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="垂直取景" FontSize="11" Foreground="{DynamicResource SkinMuted}"/><Slider x:Name="YSlider" Minimum="0" Maximum="100" Value="35" ValueChanged="AdjustPhoto" SmallChange="1" LargeChange="10" AutomationProperties.Name="背景垂直取景"/></StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock x:Name="StatusText" Text="选择会自动记住。关闭窗口即可继续使用。" FontSize="10" Foreground="{DynamicResource SkinFaint}" Margin="1,15,1,0" TextWrapping="Wrap"/>
    </StackPanel>
  </Border>
  </ScrollViewer>
</Window>
