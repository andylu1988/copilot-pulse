<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Assets\pulse-usage-v4-c.ico</ApplicationIcon>
    <AssemblyName>CopilotPulse</AssemblyName>
    <Version>1.10.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <EmbeddedResource Include="extract-consumption.js" />
    <Resource Include="Assets\bayi-background.png" />
    <Resource Include="Assets\pulse-usage-v4-c.ico" />
    <Resource Include="Assets\matrix-art-*.png" />
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**\bin\**;tests\**\obj\**" />
  </ItemGroup>
</Project>
