<Window x:Class="CopilotPulse.TasksWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CopilotPulse" Title="Copilot Pulse · Tasks" Width="1060" Height="850" MinWidth="720" MinHeight="550" Background="{DynamicResource SkinPanel}" Foreground="{DynamicResource SkinText}" FontFamily="Segoe UI, Microsoft YaHei UI" WindowStartupLocation="CenterOwner">
 <Window.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBarStyle}"><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPart}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinWidth="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource SkinEdge}" CornerRadius="4" Margin="0,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPart}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource GlassTextBoxStyle}"/>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Border BorderBrush="{DynamicResource SkinEdge}" BorderThickness="0,0,0,1"><Grid><local:GlassBackdrop/><Border Background="#1420A570"/><ContentPresenter Margin="10" VerticalAlignment="Center"/></Grid></Border></ControlTemplate></Setter.Value></Setter><Setter Property="Background" Value="#3020A570"/><Setter Property="Foreground" Value="{DynamicResource SkinMuted}"/><Setter Property="Padding" Value="10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8"/><Setter Property="Foreground" Value="{DynamicResource SkinText}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SkinHover}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource SkinChart}"/><Setter Property="Foreground" Value="{DynamicResource SkinText}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SkinHover}"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Border x:Name="TaskSurface"><Border x:Name="TaskShade"><Grid>
  <local:Atmosphere IsHitTestVisible="False" Opacity="0.5"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,22">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Heading" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource SkinAccent}"/><TextBlock x:Name="Subtitle" FontSize="11" Foreground="{DynamicResource SkinMuted}" Margin="0,6,10,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="NewButton" Grid.Column="1" Click="NewTask" VerticalAlignment="Center" Background="{DynamicResource SkinHover}"/></Grid>
   <Border Background="{DynamicResource SkinChart}" BorderBrush="{DynamicResource SkinEdge}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,16,0,12"><StackPanel><TextBlock x:Name="HealthLabel" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SkinAccent}"/><TextBlock x:Name="HealthHint" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0" Foreground="{DynamicResource SkinMuted}"/></StackPanel></Border>
   <TextBlock x:Name="EmptyLabel" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource SkinMuted}"/>
   <DataGrid x:Name="TaskList" RowHeight="40" ColumnHeaderHeight="40" Height="190" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="None" BorderThickness="0" Background="{DynamicResource SkinChart}" SelectionChanged="SelectionChanged" HorizontalScrollBarVisibility="Auto">
    <DataGrid.Columns><DataGridTextColumn x:Name="NameColumn" Binding="{Binding Name}" Width="*" MinWidth="150"/><DataGridTextColumn x:Name="StartColumn" Binding="{Binding Start}" Width="160"/><DataGridTextColumn x:Name="EndColumn" Binding="{Binding End}" Width="160"/><DataGridTextColumn x:Name="DeltaColumn" Binding="{Binding Delta}" Width="100"/><DataGridTextColumn x:Name="SamplesColumn" Binding="{Binding Samples}" Width="75"/></DataGrid.Columns>
   </DataGrid>
   <WrapPanel Margin="0,12,0,8"><TextBox x:Name="TaskName" Width="270" MaxLength="100"/><Button x:Name="RenameButton" Click="Rename" Margin="8,0,0,0" Background="{DynamicResource SkinHover}"/><Button x:Name="EndButton" Click="EndTask" Margin="8,0,0,0" Background="{DynamicResource SkinHover}"/><Button x:Name="CopyButton" Click="CopySummary" Margin="8,0,0,0" Background="{DynamicResource SkinHover}"/></WrapPanel>
   <TextBlock x:Name="SelectionSummary" FontSize="12" Foreground="{DynamicResource SkinAccent}" TextWrapping="Wrap" Margin="0,3,0,4"/>
   <TextBlock x:Name="SelectionHealth" FontSize="11" Foreground="{DynamicResource SkinMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <Border Background="{DynamicResource SkinChart}" CornerRadius="10" Padding="10"><local:HistoryChart x:Name="TaskChart" Height="155"/></Border>
   <WrapPanel Margin="0,14,0,0"><Button x:Name="ExportButton" Click="ExportSelected" Background="{DynamicResource SkinHover}"/><Button x:Name="ExportAllButton" Click="ExportAll" Background="{DynamicResource SkinHover}" Margin="8,0,0,0"/><Button x:Name="ImageButton" Click="ExportImage" Background="{DynamicResource SkinHover}" Margin="8,0,0,0"/><CheckBox x:Name="Anonymous" IsChecked="True" VerticalAlignment="Center" Foreground="{DynamicResource SkinText}" Margin="14,0,0,0"/></WrapPanel>
   <TextBlock x:Name="ExportNote" FontSize="10" Foreground="{DynamicResource SkinMuted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
   <Expander x:Name="DetailsExpander" Foreground="{DynamicResource SkinMuted}" Margin="0,8,0,0"><TextBox x:Name="SamplingDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto"/></Expander>
   <TextBlock x:Name="Result" FontSize="12" Foreground="{DynamicResource SkinAccent}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel></ScrollViewer>
 </Grid></Border></Border>
</Window>
