<Window x:Class="CopilotPulse.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CopilotPulse" Title="Copilot Pulse" Foreground="{DynamicResource SkinText}" Width="408" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" FontFamily="{DynamicResource SkinFont}" UseLayoutRounding="True" ShowInTaskbar="False">
  <Grid>
  <ScrollViewer x:Name="FullView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Border x:Name="Surface" MouseLeftButtonDown="DragHeader" Margin="10" CornerRadius="24" BorderThickness="1" BorderBrush="{DynamicResource SkinEdge}" Padding="0">
    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4"/></Border.Effect>
    <Border x:Name="PhotoShade" CornerRadius="23" Padding="0">
    <Grid>
    <local:Atmosphere x:Name="FullAtmosphere" IsHitTestVisible="False"/>
    <StackPanel x:Name="ContentStack" Margin="23,19,23,18">
      <Grid Margin="0,0,0,27" Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource SkinHover}" Margin="0,0,10,0"><Path Width="19" Height="19" Stretch="Uniform" Fill="{DynamicResource SkinAccent}" Data="M12,0 L15,8 L23,11 L15,14 L12,22 L9,14 L1,11 L9,8 Z"/></Border>
          <StackPanel><TextBlock Text="COPILOT" FontSize="10" Foreground="{DynamicResource SkinMuted}" FontWeight="SemiBold"/><TextBlock Text="Pulse" FontSize="19" FontWeight="SemiBold" Margin="0,-1,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="迷你" FontSize="11" Click="EnterMini" ToolTip="切换迷你数字框" Padding="7,7"/>
          <Button Content="换肤" FontSize="11" Click="OpenSkins" ToolTip="选择皮肤和自定义背景" Padding="7,7"/>
          <Button x:Name="PinButton" ToolTip="切换置顶" AutomationProperties.Name="切换置顶" Click="TogglePin"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M7,2 L17,2 M9,2 L9,9 L5,13 L19,13 L15,9 L15,2 M12,13 L12,22"/></Button>
          <Button ToolTip="设置" AutomationProperties.Name="设置" Click="ShowSettings"><Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource SkinMuted}" Data="M4,10 A2,2 0 1 0 4,14 A2,2 0 1 0 4,10 M12,10 A2,2 0 1 0 12,14 A2,2 0 1 0 12,10 M20,10 A2,2 0 1 0 20,14 A2,2 0 1 0 20,10"/></Button>
          <Button ToolTip="收起到系统托盘" AutomationProperties.Name="收起到系统托盘" Click="HideToTray"><Path Width="13" Height="14" Stroke="{DynamicResource SkinMuted}" StrokeThickness="1.5" Data="M1,7 L12,7"/></Button>
        </StackPanel>
      </Grid>
      <Grid Margin="0,0,0,8"><TextBlock Text="本月内部用量" FontSize="13" Foreground="{DynamicResource SkinMuted}"/><Border HorizontalAlignment="Right" Background="{DynamicResource SkinHover}" CornerRadius="6" Padding="8,3"><TextBlock x:Name="MonthLabel" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SkinMuted}"/></Border></Grid>
      <local:MoneyReadout x:Name="FullAmount" Height="61"/>
      <TextBlock x:Name="UsageProgress" FontSize="11" Foreground="{DynamicResource SkinAccent}" Margin="1,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" Margin="1,8,0,0"><TextBlock Text="INTERNAL USD" Foreground="{DynamicResource SkinFaint}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text=" · " Foreground="{DynamicResource SkinFaint}" FontSize="10"/><TextBlock x:Name="AccountsLabel" Text="等待连接数据源" Foreground="{DynamicResource SkinMuted}" FontSize="10"/></StackPanel>
      <Button Click="OpenHistory" HorizontalContentAlignment="Stretch" Padding="11,8" Background="{DynamicResource SkinChart}" Margin="0,14,0,0" ToolTip="打开用量历史" AutomationProperties.Name="打开用量历史">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="142"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="历史趋势  ↗" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SkinAccent}"/><TextBlock x:Name="HistorySummary" Text="从首次记录开始积累" FontSize="9" Foreground="{DynamicResource SkinFaint}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          <local:HistoryChart x:Name="MiniHistory" Grid.Column="1" Mini="True" Height="36" IsHitTestVisible="False"/><TextBlock x:Name="HistoryNetGrowth" Grid.Row="1" Grid.ColumnSpan="2" Text="本月净增长 —" FontSize="10" Foreground="{DynamicResource SkinMuted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Button>
      <Border x:Name="DemoBadge" Visibility="Collapsed" CornerRadius="5" Background="#493720" Padding="8,5" Margin="0,12,0,0"><TextBlock Text="示例预览 · 虚构金额，非实时数据" Foreground="#F4C77E" FontSize="11"/></Border>
      <StackPanel x:Name="DetailsPanel">
        <Grid Margin="0,27,0,12"><TextBlock Text="企业用量" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="MONTH TO DATE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SkinFaint}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <StackPanel x:Name="AccountCards"/>
        <Border x:Name="EmptyState" Background="{DynamicResource SkinPanel}" BorderBrush="{DynamicResource SkinEdge}" BorderThickness="1" CornerRadius="14" Padding="20,24">
          <StackPanel><TextBlock Text="让用量，随时可见。" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="连接 Microsoft 账户后，自动同步本月总额和企业明细。" Foreground="{DynamicResource SkinMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,18" LineHeight="21"/><Button Content="连接 Microsoft 账户  ↗" Click="OpenSource" Background="{DynamicResource SkinHover}" HorizontalAlignment="Left" Padding="13,10" FontSize="12" Foreground="{DynamicResource SkinText}"/></StackPanel>
        </Border>
        <TextBlock Text="Monthly limit 为使用上限，不代表预算。" FontSize="10" Foreground="{DynamicResource SkinMuted}" Margin="1,4,0,0"/>
      </StackPanel>
      <Border x:Name="WarningBox" Visibility="Collapsed" CornerRadius="9" Background="{DynamicResource SkinHover}" Padding="10,9" Margin="0,12,0,0"><TextBlock x:Name="WarningText" Foreground="{DynamicResource SkinAccent}" FontSize="11" TextWrapping="Wrap"/></Border>
      <Border x:Name="AlertBox" Visibility="Collapsed" CornerRadius="9" Background="#352D23" Padding="10,9" Margin="0,15,0,0"><TextBlock x:Name="AlertText" Foreground="#EAC58D" FontSize="11" TextWrapping="Wrap" LineHeight="18"/></Border>
      <Border Height="1" Background="{DynamicResource SkinEdge}" Margin="0,21,0,14"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#B2A176" Margin="0,0,7,0"/><TextBlock x:Name="StatusLabel" Text="正在连接" FontSize="11" Foreground="{DynamicResource SkinMuted}"/></StackPanel><TextBlock x:Name="UpdateLabel" Text="尚未同步" FontSize="10" Foreground="{DynamicResource SkinMuted}" Margin="13,5,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RefreshButton" ToolTip="立即刷新" AutomationProperties.Name="立即刷新" Click="RefreshNow"><Path Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource SkinMuted}" StrokeThickness="1.5" Data="M19,8 A8,8 0 1 0 20,15 M19,2 L19,8 L13,8"/></Button><Button ToolTip="打开原始页面 / 登录" AutomationProperties.Name="打开原始页面或登录" Click="OpenSource"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource SkinMuted}" StrokeThickness="1.5" Data="M12,3 L21,3 L21,12 M21,3 L10,14 M8,4 L3,4 L3,21 L20,21 L20,16"/></Button></StackPanel>
      </Grid>
    </StackPanel>
    </Grid>
  </Border>
  </Border>
  </ScrollViewer>
  <Grid x:Name="MiniHost" Margin="8" Height="114" Visibility="Collapsed" MouseLeftButtonDown="MiniMouseDown" MouseRightButtonUp="MiniContextMenu" MouseEnter="MiniEnter" MouseLeave="MiniLeave">
    <local:MoneyReadout x:Name="MiniDisplay" Tile="True" Height="96" VerticalAlignment="Top"/>
    <TextBlock x:Name="MiniUsageProgress" FontSize="8" Foreground="{DynamicResource SkinText}" Margin="14,0,14,1" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
    <Border x:Name="MiniTools" Background="{DynamicResource SkinPanel}" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,23" Visibility="Collapsed" Opacity="0">
      <StackPanel Orientation="Horizontal">
        <Button Content="展开" FontSize="9" Padding="5,3" Click="ExpandMini" ToolTip="展开完整模式"/>
        <Button Content="换肤" FontSize="9" Padding="5,3" Click="OpenSkins" ToolTip="选择皮肤"/>
        <Button Content="⋯" FontSize="11" Padding="5,1" Click="ShowSettings" ToolTip="设置 / 历史 / 刷新"/>
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</Window>
